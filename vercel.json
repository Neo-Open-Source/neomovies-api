      "source": "/api/v1/images/logos/:kp_id",
      "destination": "/api/index?route=image_logos&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/images/:kind/:id",
      "destination": "/api/index?route=image_kp&kind=:kind&id=:id"
    },
    {
      "source": "/api/v1/players/cdn/kp/:kp_id",
      "destination": "/api/index?route=cdn_player_kp&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/players/cdn/:cdn_id",
      "destination": "/api/index?route=cdn_player&cdn_id=:cdn_id"
    },
    {
      "source": "/api/v1/players/:provider/kp/:kp_id",
      "destination": "/api/index?route=player&provider=:provider&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/alloha/catalog/kp/:kp_id",
      "destination": "/api/index?route=alloha_catalog&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/hls/proxy",
      "destination": "/api/index?route=hls_proxy"
    },
    {
      "source": "/api/v1/torrents/search",
      "destination": "/api/index?route=torrents"
    },
    {
      "source": "/api/v1/favorites",
      "destination": "/api/index?route=favorites"
    },
    {
      "source": "/api/v1/favorites/:kp_id/check",
      "destination": "/api/index?route=favorites&kp_id=:kp_id&sub=check"
    },
    {
      "source": "/api/v1/favorites/:kp_id",
      "destination": "/api/index?route=favorites&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/watch-later",
      "destination": "/api/index?route=watch_later"
    },
    {
      "source": "/api/v1/watch-later/:kp_id/check",
      "destination": "/api/index?route=watch_later&kp_id=:kp_id&sub=check"
    },
    {
      "source": "/api/v1/watch-later/:kp_id",
      "destination": "/api/index?route=watch_later&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/recommendations/:kp_id",
      "destination": "/api/index?route=recommendations&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/sequels/:kp_id",
      "destination": "/api/index?route=sequels&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/sync/progress/batch",
      "destination": "/api/index?route=sync_progress_batch"
    },
    {
      "source": "/api/v1/sync/progress",
      "destination": "/api/index?route=sync_progress"
    },
    {
      "source": "/admin",
      "destination": "/api/index?route=admin_spa"
    },
    {
      "source": "/admin/auth/login",
      "destination": "/api/index?route=admin_auth_login"
    },
    {
      "source": "/admin/auth/callback",
      "destination": "/api/index?route=admin_auth_callback"
    },
    {
      "source": "/admin/auth/check",
      "destination": "/api/index?route=admin_auth_check"
    },
    {
      "source": "/api/v1/dmca",
      "destination": "/api/index?route=dmca_submit"
    },
    {
      "source": "/api/v1/blocked/:kp_id",
      "destination": "/api/index?route=blocked_check&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/admin/dmca/:id",
      "destination": "/api/index?route=admin_dmca_update&id=:id"
    },
    {
      "source": "/api/v1/admin/dmca",
      "destination": "/api/index?route=admin_dmca"
    },
    {
      "source": "/api/v1/admin/block/:kp_id",
      "destination": "/api/index?route=admin_block_delete&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/admin/block",
      "destination": "/api/index?route=admin_block"
    },
    {
      "source": "/api/v1/categories",
      "destination": "/api/index?route=public_categories"
    },
    {
      "source": "/api/v1/collection/:slug",
      "destination": "/api/index?route=public_category&slug=:slug"
    },
    {
      "source": "/api/v1/admin/categories/:id",
      "destination": "/api/index?route=admin_category&id=:id"
    },
    {
      "source": "/api/v1/admin/categories/:cat_id/items/move",
      "destination": "/api/index?route=admin_category_items_move&cat_id=:cat_id"
    },
    {
