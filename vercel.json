    },
    {
      "source": "/api/v1/images/backdrops/page/:kp_id",
      "destination": "/api/index?route=image_backdrops_page&kp_id=:kp_id"
    },
    {
      "source": "/api/v1/images/backdrops/:kp_id/:size",
      "destination": "/api/index?route=image_backdrops&kp_id=:kp_id&size=:size"
    },
    {
      "source": "/api/v1/images/backdrops/:kp_id",
      "destination": "/api/index?route=image_backdrops&kp_id=:kp_id"
    },
