    {
      "source": "/api/v1/genres",
      "destination": "/api/index?route=media_genres"
    },
    {
      "source": "/api/v1/category/:genre_id",
      "destination": "/api/index?route=media_category&genre_id=:genre_id"
    },
    {
      "source": "/api/v1/movie/:id",
      "destination": "/api/index?route=media_film&id=:id"
    },
    {
      "source": "/api/v1/tv/:kp_id/season/:season/episode/:episode",
      "destination": "/api/index?route=media_tv_episode_description&kp_id=:kp_id&season=:season&episode=:episode"
    },
    {
      "source": "/api/v1/images/proxy",
      "destination": "/api/index?route=image_proxy"
    },
    {
      "source": "/api/v1/images/screens/:kp_id/:season/:episode/:size",
      "destination": "/api/index?route=image_screens&kp_id=:kp_id&season=:season&episode=:episode&size=:size"
