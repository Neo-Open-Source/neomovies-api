{
  "framework": null,
  "bunVersion": "1.x",
  "buildCommand": "cd docs && bun install && bun run build",
  "outputDirectory": "docs/build",
  "crons": [
    {
      "path": "/api/v1/cron/imdb-ratings",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/index.html" },
    { "source": "/api/", "destination": "/api/index.html" },
    { "source": "/ru/api", "destination": "/ru/api/index.html" },
    { "source": "/ru/api/", "destination": "/ru/api/index.html" },
    { "source": "/api/v1/(.*)", "destination": "/api/handler" },
    { "source": "/openapi.json", "destination": "/api/handler" }
  ],
  "headers": [
    {
      "source": "/image/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
