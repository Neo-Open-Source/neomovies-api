                    "type": "string"
                  },
                  "season": {
                    "type": "number"
                  },
                  "episode": {
                    "type": "number"
                  },
                  "progress": {
                    "type": "number"
                  }
                }
              }
            },
            "text/plain": {
              "schema": {
                "type": "object",
                "required": [
                  "mediaId",
                  "progress"
                ],
                "properties": {
                  "mediaId": {
                    "type": "number"
                  },
                  "mediaType": {
                    "type": "string"
                  },
