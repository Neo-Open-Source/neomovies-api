    "/api/v1/sync/progress": {
      "get": {
        "tags": ["Sync"],
        "summary": "Get all sync progress",
        "operationId": "getSyncProgress",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Sync progress list" },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "tags": ["Sync"],
        "summary": "Upsert sync progress",
        "operationId": "upsertSyncProgress",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaId": { "type": "integer" },
                  "mediaType": { "type": "string" },
                  "season": { "type": "integer" },
                  "episode": { "type": "integer" },
                  "progress": { "type": "number" }
                },
                "required": ["mediaId", "progress"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Progress updated" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Sync"],
        "summary": "Delete sync progress",
        "operationId": "deleteSyncProgress",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaId": { "type": "integer" },
                  "mediaType": { "type": "string" },
                  "season": { "type": "integer" },
                  "episode": { "type": "integer" }
                },
                "required": ["mediaId"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Progress deleted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/sync/progress/batch": {
      "post": {
        "tags": ["Sync"],
        "summary": "Batch upsert sync progress",
        "operationId": "batchUpsertSyncProgress",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "mediaId": { "type": "integer" },
                        "mediaType": { "type": "string" },
                        "season": { "type": "integer" },
                        "episode": { "type": "integer" },
                        "progress": { "type": "number" }
                      },
                      "required": ["mediaId", "progress"]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Batch progress updated" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
