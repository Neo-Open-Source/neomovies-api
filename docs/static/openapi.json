{
  "openapi": "3.0.3",
  "info": {
    "title": "NeoWatch API",
    "description": "REST API for NeoWatch — movies and TV shows streaming platform. Built with TypeScript, Bun, Elysia, Prisma, and PostgreSQL.",
    "version": "3.0.0",
    "contact": {
      "name": "Neo Team",
      "url": "https://github.com/anomalyco/neowatch-api-ts"
    }
  },
  "servers": [
    { "url": "https://api.neome.uk", "description": "Production" },
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "tags": [
    { "name": "Health", "description": "API health check" },
    { "name": "Auth", "description": "Authentication via Neo ID SSO" },
    { "name": "Movies", "description": "Movie details, credits, recommendations" },
    { "name": "TV", "description": "TV show details, seasons, episodes, credits" },
    { "name": "Search", "description": "Text search and advanced filtering" },
    { "name": "Categories", "description": "Browse categories and collections" },
    { "name": "Genres", "description": "Movie and TV genre lists" },
    { "name": "Favorites", "description": "User favorites management" },
    { "name": "Watch Later", "description": "Watch later list management" },
    { "name": "Sync", "description": "Cross-device watch progress sync" },
    { "name": "Players", "description": "Video streaming providers" },
    { "name": "Images", "description": "TMDB image proxy" },
    { "name": "Torrents", "description": "Torrent search" },
    { "name": "Support", "description": "Supporters list" },
    { "name": "Webhooks", "description": "Webhook handlers" },
    { "name": "Cron", "description": "Scheduled tasks" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Neo ID access token"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": {}
        },
        "required": ["success", "data"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": { "type": "string" }
        },
        "required": ["success", "error"]
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": {
            "type": "object",
            "properties": {
              "items": { "type": "array" },
              "page": { "type": "integer" },
              "totalPages": { "type": "integer" },
              "totalResults": { "type": "integer" }
            },
            "required": ["items", "page", "totalPages", "totalResults"]
          }
        },
        "required": ["success", "data"]
      },
      "Media": {
        "type": "object",
        "properties": {
          "tmdbId": { "type": "integer" },
          "imdbId": { "type": "string", "nullable": true },
          "title": { "type": "string" },
          "originalTitle": { "type": "string" },
          "overview": { "type": "string" },
          "poster": { "type": "string", "nullable": true },
          "backdrop": { "type": "string", "nullable": true },
          "releaseDate": { "type": "string", "nullable": true },
          "genres": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" }
              }
            },
            "nullable": true
          },
          "genreIds": {
            "type": "array",
            "items": { "type": "integer" },
            "nullable": true
          },
          "voteAverage": { "type": "number" },
          "voteCount": { "type": "integer" },
          "popularity": { "type": "number" }
        }
      },
      "MediaDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Media" },
          {
            "type": "object",
            "properties": {
              "runtime": { "type": "integer", "nullable": true },
              "status": { "type": "string" },
              "tagline": { "type": "string" },
              "imdbRating": { "type": "number", "nullable": true },
              "imdbVotes": { "type": "integer", "nullable": true },
              "credits": {
                "type": "object",
                "properties": {
                  "cast": { "type": "array", "items": { "$ref": "#/components/schemas/CastMember" } },
                  "crew": { "type": "array", "items": { "$ref": "#/components/schemas/CrewMember" } }
                }
              },
              "productionCompanies": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Company" }
              }
            }
          }
        ]
      },
      "TVDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Media" },
          {
            "type": "object",
            "properties": {
              "seasons": { "type": "array", "items": { "$ref": "#/components/schemas/Season" } },
              "numberOfSeasons": { "type": "integer" },
              "numberOfEpisodes": { "type": "integer" },
              "status": { "type": "string" },
              "tagline": { "type": "string" },
              "networks": { "type": "array", "items": { "$ref": "#/components/schemas/Network" } },
              "productionCompanies": { "type": "array", "items": { "$ref": "#/components/schemas/Company" } },
              "credits": {
                "type": "object",
                "properties": {
                  "cast": { "type": "array", "items": { "$ref": "#/components/schemas/CastMember" } },
                  "crew": { "type": "array", "items": { "$ref": "#/components/schemas/CrewMember" } }
                }
              },
              "imdbRating": { "type": "number", "nullable": true },
              "imdbVotes": { "type": "integer", "nullable": true }
            }
          }
        ]
      },
      "CastMember": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "character": { "type": "string" },
          "profile": { "type": "string", "nullable": true },
          "order": { "type": "integer" }
        }
      },
      "CrewMember": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "job": { "type": "string" },
          "department": { "type": "string" },
          "profile": { "type": "string", "nullable": true }
        }
      },
      "Season": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "seasonNumber": { "type": "integer" },
          "episodeCount": { "type": "integer" },
          "overview": { "type": "string" },
          "poster": { "type": "string", "nullable": true },
          "airDate": { "type": "string", "nullable": true }
        }
      },
      "Episode": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "overview": { "type": "string" },
          "still": { "type": "string", "nullable": true },
          "airDate": { "type": "string", "nullable": true },
          "episodeNumber": { "type": "integer" },
          "seasonNumber": { "type": "integer" },
          "voteAverage": { "type": "number" },
          "runtime": { "type": "integer", "nullable": true }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "logo": { "type": "string", "nullable": true }
        }
      },
      "Network": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "logo": { "type": "string", "nullable": true }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "idToken": { "type": "string" },
          "expiresIn": { "type": "integer" }
        }
      },
      "PlayerResponse": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["iframe", "hls"] }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "example": "ok" },
                        "timestamp": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get Neo ID authorization URL",
        "operationId": "authLogin",
        "parameters": [
          { "name": "redirect_uri", "in": "query", "schema": { "type": "string" }, "description": "Custom redirect URI" }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string", "example": "https://id.neome.uk/api/v1/oauth2/authorize?..." }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "OAuth callback (sets cookies, redirects to frontend)",
        "operationId": "authCallback",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "302": { "description": "Redirect to frontend with auth cookies" }
        }
      }
    },
    "/api/v1/auth/mobile-callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "OAuth callback for mobile apps (returns tokens in JSON)",
        "operationId": "authMobileCallback",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Auth tokens",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "operationId": "authRefresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                },
                "required": ["refreshToken"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          },
          "401": { "description": "Invalid refresh token" }
        }
      }
    },
    "/api/v1/auth/profile": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current user profile",
        "operationId": "authGetProfile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "tags": ["Auth"],
        "summary": "Update user profile",
        "operationId": "authUpdateProfile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "avatar": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "operationId": "authLogout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/api/v1/auth/account": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Delete account",
        "operationId": "authDeleteAccount",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Account deleted" }
        }
      }
    },
    "/api/v1/auth/refresh-tokens": {
      "get": {
        "tags": ["Auth"],
        "summary": "List active refresh tokens",
        "operationId": "authListTokens",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of refresh tokens" }
        }
      }
    },
    "/api/v1/auth/refresh-tokens/revoke": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke a refresh token",
        "operationId": "authRevokeToken",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                },
                "required": ["refreshToken"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token revoked" }
        }
      }
    },
    "/api/v1/auth/refresh-tokens/revoke-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke all refresh tokens",
        "operationId": "authRevokeAllTokens",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "All tokens revoked" }
        }
      }
    },
    "/api/v1/movie/{id}": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get movie details",
        "operationId": "getMovie",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "language", "in": "query", "schema": { "type": "string", "default": "ru-RU" } }
        ],
        "responses": {
          "200": {
            "description": "Movie details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/movie/{id}/credits": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get movie credits (cast & crew)",
        "operationId": "getMovieCredits",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Movie credits" }
        }
      }
    },
    "/api/v1/movie/{id}/collection": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get movie collection (franchise)",
        "operationId": "getMovieCollection",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Collection with parts" }
        }
      }
    },
    "/api/v1/movie/{id}/recommendations": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get movie recommendations",
        "operationId": "getMovieRecommendations",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated recommendations",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/movie/{id}/similar": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get similar movies",
        "operationId": "getMovieSimilar",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated similar movies",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/movie/popular": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get popular movies",
        "operationId": "getPopularMovies",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated popular movies",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/movie/top-rated": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get top rated movies",
        "operationId": "getTopRatedMovies",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated top rated movies",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/movie/upcoming": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get upcoming movies",
        "operationId": "getUpcomingMovies",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated upcoming movies",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/{id}": {
      "get": {
        "tags": ["TV"],
        "summary": "Get TV show details",
        "operationId": "getTVShow",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "language", "in": "query", "schema": { "type": "string", "default": "ru-RU" } }
        ],
        "responses": {
          "200": {
            "description": "TV show details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/{id}/credits": {
      "get": {
        "tags": ["TV"],
        "summary": "Get TV show credits",
        "operationId": "getTVCredits",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "TV show credits" }
        }
      }
    },
    "/api/v1/tv/{id}/season/{seasonNumber}": {
      "get": {
        "tags": ["TV"],
        "summary": "Get season details with episodes",
        "operationId": "getTVSeason",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "seasonNumber", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Season details" }
        }
      }
    },
    "/api/v1/tv/{id}/season/{seasonNumber}/episode/{episodeNumber}": {
      "get": {
        "tags": ["TV"],
        "summary": "Get episode details",
        "operationId": "getTVEpisode",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "seasonNumber", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "episodeNumber", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Episode details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Episode" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/{id}/recommendations": {
      "get": {
        "tags": ["TV"],
        "summary": "Get TV show recommendations",
        "operationId": "getTVRecommendations",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated recommendations",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/{id}/similar": {
      "get": {
        "tags": ["TV"],
        "summary": "Get similar TV shows",
        "operationId": "getTVSimilar",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated similar TV shows",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/popular": {
      "get": {
        "tags": ["TV"],
        "summary": "Get popular TV shows",
        "operationId": "getPopularTV",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated popular TV shows",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/tv/top-rated": {
      "get": {
        "tags": ["TV"],
        "summary": "Get top rated TV shows",
        "operationId": "getTopRatedTV",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated top rated TV shows",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Search movies, TV shows, and multi",
        "operationId": "search",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Text search query" },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["movie", "tv", "multi"] } },
          { "name": "genre", "in": "query", "schema": { "type": "string" }, "description": "Genre IDs (comma-separated)" },
          { "name": "year", "in": "query", "schema": { "type": "integer" } },
          { "name": "yearFrom", "in": "query", "schema": { "type": "integer" } },
          { "name": "yearTo", "in": "query", "schema": { "type": "integer" } },
          { "name": "rating", "in": "query", "schema": { "type": "number" } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedResponse" }
              }
            }
          }
        }
      }
    },
