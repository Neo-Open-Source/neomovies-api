# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB_NAME=neowatch

# JWT
JWT_SECRET=your-super-secret-jwt-key

# Kinopoisk API
KPAPI_KEY=your-kinopoisk-api-key
KPAPI_BASE_URL=https://kinopoiskapiunofficial.tech/api

# Neo ID SSO (OAuth2)
NEO_ID_URL=https://id.neome.uk
NEO_ID_CLIENT_ID=your-neo-id-client-id
NEO_ID_CLIENT_SECRET=your-neo-id-client-secret

# Public API URL (required for mobile Neo ID callback redirect flow)
# Example: https://api.neome.uk
PUBLIC_API_URL=https://api.neome.uk

# Player tokens
HDVB_TOKEN=your-hdvb-token
VIBIX_HOST=https://vibix.example.com
VIBIX_TOKEN=your-vibix-token
LUMEX_URL=https://lumex.example.com/embed
ALLOHA_TOKEN=your-alloha-token
COLLAPS_API_HOST=https://api.collaps.example.com
COLLAPS_TOKEN=your-collaps-token

# RedAPI (torrents)
REDAPI_BASE_URL=https://jac-red.ru

# Admin notifications (DMCA takedown emails via Resend)
# Email address to receive DMCA takedown notifications
ADMIN_NOTIFY_EMAIL=admin@example.com
# URL of the admin panel (shown in notification email)
ADMIN_PANEL_URL=https://watch.neome.uk/admin
# Resend API key and sender address (required to send notification emails)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=NeoWatch <noreply@neome.uk>

# Local server
LOCAL_SERVER_PORT=3000
